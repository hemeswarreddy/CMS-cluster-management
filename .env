# Backend API Base URL
# Leave empty so React calls /api on Render, and Render server proxies it to the AWS ALB
VITE_API_BASE_URL=

# Auto-refresh interval in milliseconds (15s)
VITE_AUTO_REFRESH_INTERVAL=15000

# AWS Metadata
VITE_AWS_REGION=eu-north-1
VITE_EFS_ID=fs-04d3bc3c56af5a861
VITE_EFS_MOUNT_PATH=/var/www/html/files
